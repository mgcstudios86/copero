{
  "name": "copero",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=basic",
    "test:watch": "vitest",
    "build:web": "expo export --platform web --output-dir dist",
    "test:e2e:web": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:mobile": "maestro test e2e/mobile/home.yaml",
    "postinstall": "node scripts/patch-expo-modules-core.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "^57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "html-to-image": "^1.11.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "^57.0.7",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.0"
  }
}
