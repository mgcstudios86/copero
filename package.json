{
  "name": "coperofree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npx wrangler deploy",
    "extract": "node scripts/extract-catalog.mjs",
    "mirror:assets": "node scripts/mirror-copero-assets.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:flow": "node scripts/smoke-game-flow.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "validate:simulator-content": "node scripts/validate-simulador-content.mjs",
    "validate:career-mode-content": "node scripts/validate-career-mode-content.mjs",
    "validate:seo": "node scripts/validate-seo-output.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:deployment": "node scripts/validate-deployment.mjs",
    "preview": "vite preview",
    "preview:seo": "npm run build && node scripts/serve-built-site.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^25.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^2.1.9"
  }
}
