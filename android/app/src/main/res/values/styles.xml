<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    MGC-967 / MGC-976 — `AppTheme` sin `android:windowBackground` caía
    en `Theme.AppCompat.DayNight.NoActionBar` default. DayNight light
    mode resuelve windowBackground a #FAFAFA tras dismiss splash. Si JS
    muere silencioso (RN 0.86.2 + reanimated worklets), ReactRootView
    queda transparente sobre #FAFAFA = pantalla blanca.

    Defensa de capa 1: hardcode `@color/splashscreen_background` (#0B1320
    dark navy) en AppTheme.windowBackground. Garantiza fallback oscuro
    bajo cualquier estado React (incluso si hydration/fontsLoaded/
    onboarded gates nunca flippean). El splash drawable se mantiene
    independiente en `Theme.App.SplashScreen`.
  -->
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowBackground">@color/splashscreen_background</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splashscreen_logo</item>
  </style>
</resources>