<resources>
  <!--
    MGC-976 — `splashscreen_background` se usa como windowBackground
    fallback de AppTheme (defensa contra JS silent death post-cold-start,
    ver `styles.xml`). Antes #FFFFFF → white-screen por DayNight light
    mode. Ahora #0B1320 (dark navy) hardcoded en cualquier path:
    iceQA boots limpios, primer install sin save, slot vacío, JS stalled
    mid-hydrate, etc. El splash drawable (`splashscreen_logo.png`) es
    independiente y se mantiene sobre `Theme.App.SplashScreen`.
  -->
  <color name="splashscreen_background">#0B1320</color>
  <color name="iconBackground">#0B1320</color>
  <color name="colorPrimary">#023c69</color>
</resources>